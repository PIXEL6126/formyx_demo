# ============================================================
# Formyx Backend — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Runtime logs
*.log
logs/
*.jsonl

# ML model weights (large files — store with Git LFS or separately)
models/*.pt
models/*.onnx
*.pt
*.onnx
*.tflite

# Training runs and dataset (large, generated)
training/balloon_dataset
runs/

# Video recordings (generated at runtime)
camrec/

# Evaluation results (generated)
eval_results/

# Scratch/temp files
scratch/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Sensitive config overrides (never commit hardware-specific settings)
config/settings.local.yaml
